{
  "name": "awesome-copilot-for-testers",
  "version": "1.0.0",
  "description": "A collection of resources for using GitHub Copilot for testing and automation.",
  "scripts": {
    "generate": "node scripts/regenerate-readme.js",
    "check": "node scripts/regenerate-readme.js --check",
    "plugin:generate": "node scripts/generate-plugins.js",
    "plugin:generate:all": "node scripts/generate-plugins.js --all-skills",
    "plugin:generate:check": "node scripts/generate-plugins.js --check",
    "plugin:generate:dry": "node scripts/generate-plugins.js --dry-run",
    "plugin:materialize": "node scripts/materialize-plugins.js",
    "lint": "node scripts/lint-frontmatter.js && node scripts/lint-orchestration.js && node scripts/generate-plugins.js --check && node scripts/check-plugin-sync.js"
  },
  "author": "jaktestowac.pl",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jaktestowac/awesome-copilot-for-testers.git"
  },
  "keywords": [
    "github",
    "copilot",
    "testing",
    "testers",
    "resources",
    "prompts",
    "tools",
    "automation",
    "playwright",
    "playwright-mcp",
    "a11y",
    "accessibility",
    "test automation"
  ]
}
